{
  "name": "oogaboogaland",
  "version": "0.1.0",
  "description": "EntropyLab contributor vivarium: a WebGL2 lab where donated bananas feed the Ooga Boogas",
  "private": true,
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "poker:serve": "node scripts/build.mjs && node server/poker/server.mjs",
    "poker:verify": "node server/poker/verify.mjs",
    "site": "node scripts/site.mjs",
    "cards": "node scripts/build.mjs && node scripts/cards.mjs",
    "build:site": "node scripts/site.mjs _site --audio-assets && cp worker/_headers _site/_headers && node scripts/characters.mjs --json > worker/src/characters.gen.json",
    "serve": "node scripts/serve.mjs",
    "watch": "node scripts/serve.mjs --watch",
    "characters": "node scripts/characters.mjs --list",
    "characters:json": "node scripts/characters.mjs --json",
    "test:unit": "node test/run.mjs unit",
    "test": "node scripts/build.mjs && node test/run.mjs",
    "test:perf": "node scripts/build.mjs && node test/run.mjs perf",
    "test:full": "node scripts/build.mjs && node test/run.mjs full"
  }
}
